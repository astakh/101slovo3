# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/101slovo

# ─── JWT & Auth ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-string

# ─── GigaChat LLM ────────────────────────────────────────────────────
GIGACHAT_AUTH_KEY=your-auth-key-here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_CA_CERT_PATH=./certs/russian_trusted_root_ca_pem.crt

# ─── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
